# 1. FRONTEND KEYS (Safe for the browser, required for Login/Register)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. BACKEND KEYS (Strictly hidden from the browser, required for API/Migrations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

CROSSREF_USERNAME=your-crossref-username
CROSSREF_PASSWORD=your-crossref-password

RESEND_API_KEY=your-resend-api-key

# 3. ORCID PUBLIC API KEYS (For user profile linking)
# Register a free Public API client at https://orcid.org/developer-tools
# Note: Ensure that the redirect URI (e.g. http://localhost:3000/api/auth/orcid/callback in development) 
# is added to your ORCID developer tools configuration.
ORCID_CLIENT_ID=your-orcid-client-id-here
ORCID_CLIENT_SECRET=your-orcid-client-secret-here
